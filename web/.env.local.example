# OpenRouter (para la generación de interpretaciones)
# Consigue tu key en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# Modelo de OpenRouter a utilizar
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview

# Título público de la app (opcional, lo envía OpenRouter como referer para ranking)
NEXT_PUBLIC_APP_NAME=Luna Astro
NEXT_PUBLIC_APP_URL=http://localhost:3000
